# Copy to .env and fill in. Everything is optional in development.

# "production" turns off dev shortcuts (codes shown on screen) and requires email + SMS to be configured.
NIGHTSWAP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
BASE_URL=http://localhost:5000

# Business rules
NIGHTSWAP_FEE_PERCENT=8           # buyer fee per ticket, % of the ticket price
NIGHTSWAP_FEE_MIN_CENTS=150       # ...but at least this much (150 = EUR 1.50)
NIGHTSWAP_SELLER_FEE_PERCENT=5    # seller fee per ticket, % of the price, taken from the payout
NIGHTSWAP_SELLER_FEE_MIN_CENTS=100 # ...but at least this much (100 = EUR 1.00)
NIGHTSWAP_FEE_MAX_CENTS=0         # optional cap per ticket (0 = none)
NIGHTSWAP_PRICE_CAP_PERCENT=120    # max resale price as % of face value (120 = up to 20% above)
NIGHTSWAP_PAYOUT_DELAY_HOURS=48    # hours after the event night before the seller is paid
ADMIN_EMAILS=you@example.com       # comma-separated; these accounts can see /admin

# Stripe (leave empty to use the built-in simulated checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (SMTP). Without it, codes are printed to the console in development.
# iCloud: SMTP_HOST=smtp.mail.me.com, SMTP_USER=you@icloud.com, SMTP_PASSWORD=app-specific password,
#         MAIL_FROM=Spare <you@icloud.com>. Check with: flask --app app test-email you@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Spare <hello@sparetickets.eu>

# SMS via Twilio. Without it, codes are printed to the console in development.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
